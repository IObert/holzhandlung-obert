# Copy this to .env.deploy.local. Keep real credentials only in that ignored file.
# Match FileZilla's Site Manager connection settings.
# ftp = FTP/FTPS; sftp = SSH File Transfer Protocol (FileZilla Protocol 1).
FTP_PROTOCOL=sftp
FTP_HOST=hosting.telekom.de
FTP_USER=
FTP_PASSWORD=

# Use the website directory shown in FileZilla's remote pane.
# This path is relative to your FTP account's root, not the server's system root.
# Examples: /public_html, /htdocs, or / for an account already jailed to the site.
FTP_REMOTE_DIR=/home/www/public_html

# true = explicit FTPS (recommended), implicit = implicit FTPS, false = plain FTP.
# FTP_SECURE only applies to FTP/FTPS; it is ignored for SFTP.
FTP_SECURE=true
# SFTP uses 22; explicit FTPS/plain FTP normally use 21; implicit FTPS uses 990.
FTP_PORT=22

# Quote passwords containing #, spaces, or other dotenv-sensitive characters.
# Example: FTP_PASSWORD="replace-with-your-password"

# Public Telekom ED25519 fingerprint, independently verified against provider docs.
# Format: SHA256:... (not the server password).
SFTP_HOST_KEY_SHA256=SHA256:89n1iYXwnueGbEMW4LTeqR1615iqwiiyMgn+/0i+2Bc

# Optional public URL used by deploy:inspect to confirm the document root.
DEPLOY_PUBLIC_URL=https://holzhandlung-obert.de/
