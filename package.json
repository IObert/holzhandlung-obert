{
  "name": "holzhandlung-obert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp tk_hosting_files/.htaccess out/.htaccess",
    "start": "next start",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm test:export && pnpm test:deploy && pnpm test:e2e",
    "test:export": "node --test tests/export.test.mjs",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --grep Screenshot --update-snapshots",
    "preview": "node scripts/serve-export.mjs",
    "deploy": "pnpm build && pnpm test:export && node --env-file=.env.deploy.local scripts/deploy.mjs",
    "deploy:plan": "pnpm build && pnpm test:export && node --env-file-if-exists=.env.deploy.local scripts/deploy.mjs --dry-run",
    "test:deploy": "node --test tests/deploy.test.mjs",
    "deploy:inspect": "node --env-file=.env.deploy.local scripts/inspect-deploy.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "v0": "^3.0.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "basic-ftp": "^6.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "parse5": "^8.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  }
}
